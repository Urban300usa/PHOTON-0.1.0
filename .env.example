# ============================================================================
# PHOTON — environment template.  Copy to ".env" and fill in real values.
# Used by docker-compose.prod.yml on a DigitalOcean droplet.
# NEVER commit the real .env (it is gitignored).
# ============================================================================

# --- Core ---
NODE_ENV=production
PORT=5000

# Public URL the app is served at. Used to build the EVE OAuth callback,
# so it MUST match the domain registered in the EVE developer portal (https://).
APP_URL=https://photon.yourdomain.com

# Domain for Caddy's automatic HTTPS (host only, no scheme)
DOMAIN=photon.yourdomain.com

# --- Database (compose 'db' service reads POSTGRES_PASSWORD) ---
# Generate a strong password:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql://photon:change-me-strong-db-password@db:5432/photon

# --- Sessions ---
# Generate:  openssl rand -hex 32
SESSION_SECRET=change-me-64-char-random-hex

# --- EVE Online SSO (from https://developers.eveonline.com applications) ---
# NOTE: the app reads EVE_CLIENT_ID / EVE_CLIENT_SECRET (NOT ESI_*).
EVE_CLIENT_ID=your-eve-app-client-id
EVE_CLIENT_SECRET=your-eve-app-secret-key

# Comma-separated EVE character IDs that get admin access (optional)
EVE_ADMIN_IDS=

# --- Optional: dev-login bypass (NOT used in production) ---
# EVE_DEV_CLIENT_ID=
# EVE_DEV_CLIENT_SECRET=

# --- Optional: object storage (only if you use file uploads/exports) ---
# On DigitalOcean this maps to Spaces (S3-compatible). Leave unset to disable.
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=
